# =============================================================================
# soui_res.cmake -- SOUI resources for ESP-IDF targets:
#
#   uires/*.idx + files --(uiresbuilder)--> soui_res/soui_res.rc2 + resource.h
#   main.rc  (#include soui_res.rc2 + theme_sys_res.rc2)
#            --(windres)--> PE-COFF
#            --(.incbin)--> ELF object in .rodata.embedded
#
# The last object is linked into the image and located at runtime through the
# weak symbols _binary_soui_coff_o_start/_end (swinx/src/resapi.cpp), which is
# how a Windows build's PE resources are served here: the app sees the normal
# SResProviderPE / FindResource / LoadResource path.
#
# Why the extra .incbin hop: the windres output is a COFF *object*, but nothing
# links it as code -- swinx parses it as a file image (section headers, then
# .rsrc).  So it has to become data inside the image, addressed by symbol.
#
# Why ".rodata.embedded" and not the ".rdata" the desktop pipeline uses:
# ESP-IDF's linker fragments only collect `.rodata+`/`.srodata+` into flash
# (components/esp_common/common.lf -> [sections:rodata]); `.rdata` matches
# nothing, so the section ends up unplaced and the symbols resolve to garbage.
# `.rodata.embedded` is the same name IDF's own target_add_binary_data() uses.
#
# Editing resources: change a file under <project>/uires or the system theme,
# rebuild -- nothing has to be regenerated by hand and no C array is emitted.
# =============================================================================

# soui_idf_add_resources(<target>)
#
# <target> is the component library the blob is linked into (normally
# ${COMPONENT_LIB} of the `main` component).  Paths are derived from this
# file's location, so the module can be included from any component directory.
function(soui_idf_add_resources target)
    # <soui4>/soui-freertos/esp32s3/cmake -> <soui4>
    get_filename_component(_soui_root "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
    # 本文件在 <project>/cmake/ 下 -> <project>
    get_filename_component(_proj_dir "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

    set(_uires_dir     "${_proj_dir}/uires")
    set(_idx_file      "${_uires_dir}/uires.idx")
    set(_rc_out_dir    "${_proj_dir}/soui_res")          # 生成的 rc2 + resource.h（入库）
    set(_rc2           "${_rc_out_dir}/soui_res.rc2")
    set(_res_h         "${_rc_out_dir}/resource.h")
    set(_rc_script     "${_proj_dir}/main.rc")
    # SOUI 系统资源（skins/msgbox/editmenu/theme）。light = SVG 变体：cairo 用
    # nanosvg 直接画矢量，比 PNG 字模省 flash，也不依赖缩放质量。
    set(_sys_res_dir   "${_soui_root}/soui-sys-resource-light")

    set(_work_dir      "${CMAKE_CURRENT_BINARY_DIR}/soui_res")
    file(MAKE_DIRECTORY "${_work_dir}")

    set(_coff          "${_work_dir}/soui_res.coff.o")
    set(_asm           "${_work_dir}/soui_res.blob.S")
    set(_obj           "${_work_dir}/soui_res.blob.o")

    # ---------------------------------------------------------------------
    # step 1: uires.idx -> soui_res.rc2 + resource.h
    # ---------------------------------------------------------------------
    # CONFIGURE_DEPENDS：新增/删除 uires 下的文件也要能触发重生成，否则必须手动
    # 重跑一次 cmake（GLOB 在 configure 时求值，是 CMake 的经典坑）。
    file(GLOB_RECURSE _uires_files CONFIGURE_DEPENDS "${_uires_dir}/*")

    # 注意是 CMAKE_HOST_WIN32，不是 WIN32。IDF 的交叉编译工具链把
    # CMAKE_SYSTEM_NAME 设成 Generic，WIN32 恒为 FALSE（实测配置输出走了
    # "非 Windows 宿主" 分支），那样改了资源永远不会自动重生成 rc2。
    # uiresbuilder.exe 是宿主工具，能不能跑取决于宿主而非目标平台。
    if(CMAKE_HOST_WIN32)
        set(_uiresbuilder "${_soui_root}/tools/uiresbuilder.exe")
        if(NOT EXISTS "${_uiresbuilder}")
            message(FATAL_ERROR
                "[soui_res] uiresbuilder not found: ${_uiresbuilder}")
        endif()
        if(NOT EXISTS "${_idx_file}")
            message(FATAL_ERROR "[soui_res] ${_idx_file} not found")
        endif()

        # WORKING_DIRECTORY = 项目根：uiresbuilder 用 "<prefix>/<path>" 去打开每个
        # 布局收集 name="..." 属性（R.id/R.name 表），prefix 必须相对项目根，rc2
        # 里的路径也才能被 windres 从同一目录解析到。
        add_custom_command(OUTPUT "${_rc2}" "${_res_h}"
            COMMAND "${_uiresbuilder}" -p uires -i "${_idx_file}"
                    -r "${_rc2}" -h "${_res_h}" idtable
            DEPENDS "${_uiresbuilder}" "${_idx_file}" ${_uires_files}
            WORKING_DIRECTORY "${_proj_dir}"
            COMMENT "[uiresbuilder] uires.idx -> soui_res.rc2 + resource.h"
            VERBATIM)
        set(_rc2_deps "${_rc2}")
    else()
        if(NOT EXISTS "${_rc2}" OR NOT EXISTS "${_res_h}")
            message(FATAL_ERROR
                "[soui_res] 非 Windows 宿主且没有现成的 ${_rc2}。uiresbuilder 只能"
                "在 Windows 上运行，请先在 Windows 上构建一次（产物入库）。")
        endif()
        message(STATUS "[soui_res] 非 Windows 宿主，复用现成的 ${_rc2}")
        # rc2 已入库，windres 仍要跟着源资源文件变化重跑（见下方 DEPENDS）。
        set(_rc2_deps "")
    endif()

    # ---------------------------------------------------------------------
    # step 2: .rc -> PE-COFF
    # ---------------------------------------------------------------------
    # windres 由 mingw 提供（MSYS2 的 mingw64、或 Linux/macOS 的 mingw-w64）。
    # 它只用来编译 .rc，不参与 C/C++ 编译，所以和"用不用 mingw 编译器"无关。
    find_program(SOUI_RES_WINDRES NAMES windres x86_64-w64-mingw32-windres)
    if(NOT SOUI_RES_WINDRES)
        message(FATAL_ERROR
            "[soui_res] windres not found -- 编译 ${_rc_script} 需要 mingw 的 windres"
            "（MSYS2: pacman -S mingw-w64-x86_64-binutils；Linux: apt install binutils-mingw-w64-x86-64）")
    endif()

    # windres 默认调用 PATH 里的 `gcc -E -xc -DRC_INVOKED` 来预处理 .rc。
    # IDF 的 ninja 规则统一走 cmd.exe，它的 PATH 是 Xtensa 交叉工具链 + IDF
    # python，没有 mingw 的 gcc / cc1 / 运行时 DLL；windres 只会含糊地报
    # "preprocessing failed."（在 Git Bash 里手工跑同一条命令却成功）。
    # 把 windres 所在目录前置到这条命令的 PATH 即可（cmake -E env --modify，
    # 只影响本条 custom command，不污染整个构建）。显式 --preprocessor 也试过：
    # gcc 能找到但缺 PATH 里的运行时目录，照样退出 1。
    get_filename_component(_windres_dir "${SOUI_RES_WINDRES}" DIRECTORY)
    if(CMAKE_VERSION VERSION_LESS 3.25)
        message(FATAL_ERROR
            "[soui_res] 需要 CMake >= 3.25（cmake -E env --modify）。"
            "IDF 5.4 自带的 CMake 是 3.30.2。")
    endif()
    set(_windres_env
        "${CMAKE_COMMAND}" -E env
        "--modify" "PATH=path_list_prepend:${_windres_dir}")

    if(NOT EXISTS "${_sys_res_dir}/theme_sys_res.rc2")
        message(FATAL_ERROR
            "[soui_res] ${_sys_res_dir}/theme_sys_res.rc2 不存在，检查 soui4 工作目录布局")
    endif()
    file(GLOB_RECURSE _sys_res_files CONFIGURE_DEPENDS
         "${_sys_res_dir}/theme_sys_res/*")

    # --target=pe-x86-64 / -O coff: 只要一个能装资源的 COFF，不需要和 Xtensa
    # 扯上关系；swinx 的 coffparser 认得 I386/AMD64/ARMNT/ARM64 四种 machine。
    # 段内 DATA_ENTRY.DataRVA 是相对 .rsrc 起始的偏移（object 里段 RVA 为 0），
    # 所以不重定位也能被 coffparser 正确定位。
    add_custom_command(OUTPUT "${_coff}"
        COMMAND ${_windres_env} ${SOUI_RES_WINDRES} --target=pe-x86-64
                --include-dir "${_rc_out_dir}"        # soui_res.rc2
                --include-dir "${_sys_res_dir}"       # theme_sys_res.rc2
                -i "${_rc_script}" -o "${_coff}" -O coff
        DEPENDS "${_rc_script}" ${_rc2_deps} ${_uires_files} ${_sys_res_files}
        WORKING_DIRECTORY "${_proj_dir}"
        COMMENT "windres: main.rc (app + sys resources) -> COFF"
        VERBATIM)

    # ---------------------------------------------------------------------
    # step 3: COFF -> .incbin data blob
    # ---------------------------------------------------------------------
    # .balign 4：coffparser 直接按 uint16/uint32 读段头，Xtensa 不允许非对齐访问。
    file(GENERATE OUTPUT "${_asm}" CONTENT
"    .section .rodata.embedded,\"a\",@progbits
    .balign 4
    .globl _binary_soui_coff_o_start
    .globl _binary_soui_coff_o_end
_binary_soui_coff_o_start:
    .incbin \"${_coff}\"
_binary_soui_coff_o_end:
    .balign 4
")

    add_custom_command(OUTPUT "${_obj}"
        COMMAND "${CMAKE_C_COMPILER}" -c "${_asm}" -o "${_obj}"
        DEPENDS "${_asm}" "${_coff}"
        COMMENT "embedding soui_res COFF into the image (.rodata.embedded)"
        VERBATIM)

    # The blob is data, not code: nothing references it strongly inside the
    # component, so if it were just another object of the archive the linker
    # would drop it (they are kept alive by a strong reference from app_main).
    target_sources(${target} PRIVATE "${_obj}")

    set(SOUI_RES_INCLUDE_DIR "${_rc_out_dir}" PARENT_SCOPE)
endfunction()
