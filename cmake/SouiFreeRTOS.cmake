# =============================================================================
# SouiFreeRTOS.cmake -- one shared build description for every
# "SOUI on FreeRTOS" target in soui-freertos/.
#
# Before this file existed each project (soui_fr, soui_sim, swinx_test) carried
# its own copy of ~300-480 lines that re-listed every dependency source, every
# include directory and every compile definition.  Now the description lives
# here once and a project only says *what it wants*:
#
#   set(SOUI_FR_CONFIG_DIR ${CMAKE_CURRENT_SOURCE_DIR}/config)   # FreeRTOSConfig.h
#   include(${CMAKE_CURRENT_LIST_DIR}/../cmake/SouiFreeRTOS.cmake)
#   soui_fr_add_all()                     # (host) third-party + swinx + SOUI
#   add_executable(app main.cpp)
#   target_link_libraries(app PRIVATE soui_fr::app)   # includes/defines follow
#
# Everything a consumer needs (include dirs, -D flags, force-included compat
# header) hangs off INTERFACE targets, so "just link and go" replaces the
# per-project target_include_directories() walls.
#
# Targets created (all guarded, safe to call once per build tree):
#   soui_fr_platform       INTERFACE  include dirs + defines + options (alias soui_fr::platform)
#   soui_fr_thirdparty     INTERFACE  pixman/zlib/libpng/cairo        (alias soui_fr::thirdparty)
#   soui_fr_swinx          INTERFACE  swinx_core                      (alias soui_fr::swinx)
#   soui_fr_soui           INTERFACE  utilities+SOUI+render-gdi+stb    (alias soui_fr::soui)
#   soui_fr_freertos       INTERFACE  FreeRTOS kernel (host simulation) (alias soui_fr::freertos)
#   soui_fr_app            INTERFACE  everything an app needs         (alias soui_fr::app)
#
# Options (all default to something sane for the current toolchain):
#   SOUI_FR_USE_SYSTEM_DEPS  host builds: link the distro's cairo/pixman/png/zlib
#                            instead of compiling the vendored sources.
#                            Cross builds (ARM) always use the vendored sources:
#                            a bare-metal image must not depend on host packages.
#   SOUI_FR_ROOT             soui4 source tree; fixed at <this file>/../.. --
#                            soui-freertos is a submodule of soui4, not movable
#   SOUI_FR_FREERTOS_DIR     FreeRTOS kernel; fixed at <soui-freertos>/FreeRTOS-Kernel
#   SOUI_FR_CONFIG_DIR       directory holding FreeRTOSConfig.h (consumer sets it)
#   SOUI_FR_WARNINGS         keep compiler warnings (default OFF: -w)
#
# On Windows, soui_fr_link_app() also harvests the runtime DLLs next to the
# executable (see CopyRuntimeDlls.cmake): the system-deps build imports
# libcairo-2.dll, and any other MinGW prefix earlier in PATH (PortableGit,
# Android platform-tools, xampp) would shadow libwinpthread/zlib/iconv and
# abort the process at load time with 0xc0000139 before main().
#
# What the code sees: swinx derives every platform decision from the switches
# in swinx/include/sfr_config.h (SFR_PLATFORM / SFR_HOSTED / SFR_KERNEL_*), so
# the -D list below is the only place that has to know the flag spelling.
# =============================================================================
include_guard(GLOBAL)

get_filename_component(SOUI_FR_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
get_filename_component(SOUI_FR_ENV_DIR "${SOUI_FR_CMAKE_DIR}" DIRECTORY)

# -----------------------------------------------------------------------------
# source tree / kernel / toolchain facts
# -----------------------------------------------------------------------------
# soui-freertos 是 soui4 的子模块，位置固定为 <soui4>/soui-freertos：本文件在
# <soui4>/soui-freertos/cmake/ 下，往上两级就是 soui4 工作目录的根。
# 只有一级相对推导 + 一个存在性检查，不做任何环境变量/盘符回落
# （旧的回落写死 "D:/work/soui4"，CI 检出在别的路径时会对着不存在的树找
#  uiresbuilder.exe，报一个与真实原因无关的错）。
get_filename_component(SOUI_FR_ROOT "${SOUI_FR_ENV_DIR}/.." ABSOLUTE)
if(NOT EXISTS "${SOUI_FR_ROOT}/SOUI/include/souistd.h")
    message(FATAL_ERROR
        "[soui_fr] ${SOUI_FR_ROOT} 下没有 SOUI/include/souistd.h。"
        "soui-freertos 是 soui4 的子模块，必须检出在 soui4 工作目录下"
        "（<soui4>/soui-freertos）。")
endif()

# Generated headers for this build.  Two separate directories on purpose:
#   gen/soui_fr  -- the SOUI build-flag config.h pulled in by utilities-def.h
#   gen/cairo    -- cairo's own config.h + pixman-version.h (vendored build)
# They must not share a directory: both files are called config.h and would
# overwrite each other (this already cost a debugging session once).
set(SOUI_FR_GEN_DIR "${CMAKE_CURRENT_BINARY_DIR}/gen/soui_fr")
set(SOUI_FR_CAIRO_GEN_DIR "${CMAKE_CURRENT_BINARY_DIR}/gen/cairo")
file(MAKE_DIRECTORY "${SOUI_FR_GEN_DIR}" "${SOUI_FR_CAIRO_GEN_DIR}")
file(WRITE "${SOUI_FR_GEN_DIR}/config.h" "\
/* config.h -- generated by SouiFreeRTOS.cmake: static-lib build of the
 * utilities + SOUI core for FreeRTOS.  Each consumer used to carry its own
 * copy under soui-freertos/<project>/gen; this is now the single source. */
#define LIB_SOUI_COM
#define LIB_CORE
#define DISABLE_SWNDSPY 1
")

set(SOUI_FR_SWINX_DIR "${SOUI_FR_ROOT}/swinx")
set(SOUI_FR_SOUI_DIR  "${SOUI_FR_ROOT}/SOUI")
set(SOUI_FR_UTIL_DIR  "${SOUI_FR_ROOT}/utilities")

# FreeRTOS 内核是 soui-freertos 的子模块，位置固定为 <soui4>/soui-freertos/FreeRTOS-Kernel。
set(SOUI_FR_FREERTOS_DIR "${SOUI_FR_ENV_DIR}/FreeRTOS-Kernel")
if(NOT EXISTS "${SOUI_FR_FREERTOS_DIR}/tasks.c")
    message(FATAL_ERROR
        "[soui_fr] ${SOUI_FR_FREERTOS_DIR} 下没有 tasks.c。请执行 "
        "git submodule update --init soui-freertos/FreeRTOS-Kernel")
endif()

# Host (desktop simulator) vs bare-metal target.  Everything below keys off
# this instead of the four different preprocessor macros the C++ side used to
# guess with.
if(CMAKE_CROSSCOMPILING OR CMAKE_SYSTEM_NAME STREQUAL "Generic")
    set(SOUI_FR_BARE_METAL ON)
else()
    set(SOUI_FR_BARE_METAL OFF)
endif()

if(SOUI_FR_BARE_METAL)
    set(SOUI_FR_PORT_DIR "${SOUI_FR_FREERTOS_DIR}/portable/GCC/ARM_CM3")
    set(SOUI_FR_STACK_WORDS 8192)
else()
    set(SOUI_FR_PORT_DIR "${SOUI_FR_FREERTOS_DIR}/portable/MSVC-MingW")
    set(SOUI_FR_STACK_WORDS 32768)
endif()

option(SOUI_FR_WARNINGS "Keep compiler warnings for SOUI/swinx/third-party sources" OFF)

# System packages: only for host builds, and only when pkg-config can prove
# each of them exists.  The result is stored as a REAL cache entry: the old
# "option() over a normal variable of the same name" trick does not create one
# under CMP0077, so every reconfigure re-ran the probe and silently flipped the
# user's -DSOUI_FR_USE_SYSTEM_DEPS=OFF back to ON.
# pkg_check_modules() runs below whenever the flag ends up ON, so the module
# has to be loaded in every branch (not only when we do the probe).
find_package(PkgConfig QUIET)

if(DEFINED SOUI_FR_USE_SYSTEM_DEPS)
    set(_soui_fr_sysdeps "${SOUI_FR_USE_SYSTEM_DEPS}")
elseif(SOUI_FR_BARE_METAL)
    set(_soui_fr_sysdeps OFF)
else()
    set(_soui_fr_sysdeps OFF)
    if(PKG_CONFIG_FOUND)
        pkg_check_modules(_soui_fr_probe QUIET cairo pixman-1 libpng zlib)
        if(_soui_fr_probe_FOUND)
            set(_soui_fr_sysdeps ON)
        endif()
    endif()
endif()
set(SOUI_FR_USE_SYSTEM_DEPS "${_soui_fr_sysdeps}" CACHE BOOL
    "Link the host's cairo/pixman/libpng/zlib instead of building the vendored sources" FORCE)
unset(_soui_fr_sysdeps)

set(SOUI_FR_WARN_FLAGS "")
if(NOT SOUI_FR_WARNINGS)
    set(SOUI_FR_WARN_FLAGS "-w")
    if(NOT MSVC)
        list(APPEND SOUI_FR_WARN_FLAGS "-fpermissive")
    endif()
endif()

message(STATUS "[soui_fr] root=${SOUI_FR_ROOT}")
message(STATUS "[soui_fr] kernel=${SOUI_FR_FREERTOS_DIR} port=${SOUI_FR_PORT_DIR}")
message(STATUS "[soui_fr] bare_metal=${SOUI_FR_BARE_METAL} system_deps=${SOUI_FR_USE_SYSTEM_DEPS}")

# Resolve the host packages here (file scope, not inside a function) so that
# the include-order decision below can see their directories.
if(SOUI_FR_USE_SYSTEM_DEPS)
    pkg_check_modules(SOUI_FR_CAIRO REQUIRED IMPORTED_TARGET cairo)
    pkg_check_modules(SOUI_FR_PIXMAN REQUIRED IMPORTED_TARGET pixman-1)
    pkg_check_modules(SOUI_FR_PNG REQUIRED IMPORTED_TARGET libpng)
    pkg_check_modules(SOUI_FR_ZLIB REQUIRED IMPORTED_TARGET zlib)
endif()

# -----------------------------------------------------------------------------
# include path sets -- the single source of truth used by every target below
# -----------------------------------------------------------------------------
set(SOUI_FR_INCLUDE_BEFORE
    "${SOUI_FR_SWINX_DIR}/src/platform/freertos/stl"   # <thread>/<mutex> shims first
    "${SOUI_FR_SWINX_DIR}/src/platform/freertos/uuid"
    "${SOUI_FR_CMAKE_DIR}"                             # soui_fr_compat.h lives here
)

set(SOUI_FR_INCLUDE_COMMON
    "${SOUI_FR_SWINX_DIR}"                            # "src/wndobj.h" style includes
    "${SOUI_FR_SWINX_DIR}/include"
    "${SOUI_FR_SWINX_DIR}/src"
    "${SOUI_FR_SWINX_DIR}/src/gdi/cairo"              # FontFallback.h
    "${SOUI_FR_GEN_DIR}"                              # LIB_CORE / LIB_SOUI_COM
    "${SOUI_FR_FREERTOS_DIR}/include"
    "${SOUI_FR_PORT_DIR}"
    "${SOUI_FR_ROOT}"
    "${SOUI_FR_ROOT}/components"
    "${SOUI_FR_SOUI_DIR}"
    "${SOUI_FR_UTIL_DIR}/include"
    "${SOUI_FR_SOUI_DIR}/include"
    "${SOUI_FR_SOUI_DIR}/src"
    "${SOUI_FR_ROOT}/third-part/nanosvg"
)

# The bare-metal cairo build carries a hand-written cairo-features.h stub next
# to the platform sources; it must shadow cairo's own header.  A host build that
# links the distro cairo must NOT see it, so that directory only joins the
# public include path for the vendored build (swinx_core adds it privately
# otherwise, because its platform headers live there).
set(SOUI_FR_INCLUDE_SWINX_PLATFORM "${SOUI_FR_SWINX_DIR}/src/platform/freertos")

set(SOUI_FR_INCLUDE_RENDERGDI
    "${SOUI_FR_ROOT}/components/render-gdi"
    "${SOUI_FR_ROOT}/components/render-gdi/linux"
)

set(SOUI_FR_INCLUDE_IMGSTB
    "${SOUI_FR_ROOT}/components/imgdecoder-stb"
    "${SOUI_FR_ROOT}/third-part/stb"
    "${SOUI_FR_ROOT}/third-part/pbl_aupng/include"
)

# The force-included compat header (<climits>/<cstdint> + the STL shims).
set(SOUI_FR_COMPAT_HEADER "soui_fr_compat.h")

# -----------------------------------------------------------------------------
# soui_fr_platform -- what every translation unit in this build tree needs
# -----------------------------------------------------------------------------
function(soui_fr_create_platform_target)
    if(TARGET soui_fr_platform)
        return()
    endif()

    add_library(soui_fr_platform INTERFACE)
    add_library(soui_fr::platform ALIAS soui_fr_platform)

    if(SOUI_FR_USE_SYSTEM_DEPS)
        # Cairo's real headers must win over the bare-metal cairo-features.h
        # stub that sits next to the swinx platform sources (that directory has
        # to stay on the include path anyway: it carries dlfcn.h/dirent.h).
        target_include_directories(soui_fr_platform BEFORE INTERFACE
            ${SOUI_FR_CAIRO_INCLUDE_DIRS})
    endif()
    target_include_directories(soui_fr_platform BEFORE INTERFACE
        ${SOUI_FR_INCLUDE_BEFORE})
    target_include_directories(soui_fr_platform INTERFACE
        ${SOUI_FR_INCLUDE_COMMON}
        ${SOUI_FR_INCLUDE_SWINX_PLATFORM}
        ${SOUI_FR_CONFIG_DIR})

    target_compile_definitions(soui_fr_platform INTERFACE
        SOUI_FREERTOS_REAL
        SOUI_PLATFORM_FREERTOS
        SOUI_EXPORTS
        # SVG support (nanosvg): Svg.cpp compiles to stubs without it, and the
        # flag also gates the public helpers callers include from <core/Svg.h>.
        SOUI_ENABLE_SVG
        ENABLE_THUNK=0
        SWINX_FR_DEFAULT_STACK_WORDS=${SOUI_FR_STACK_WORDS}
        # WCHAR_SIZE (swinx src/uniconv.h) comes from the compiler, never from a
        # hand-written constant: 2 on the MinGW host, 4 on ARM newlib.
        WCHAR_SIZE=__SIZEOF_WCHAR_T__)

    if(NOT SOUI_FR_BARE_METAL)
        # "A host C library is underneath": swinx must not re-declare CRT
        # symbols (_wtof, wcscpy_s, _open_osfhandle, __int64, bsearch...) and
        # must not decorate its implementations with DECLSPEC_IMPORT.
        target_compile_definitions(soui_fr_platform INTERFACE
            FREERTOS_HOST)
    endif()

    if(SOUI_FR_WARN_FLAGS)
        target_compile_options(soui_fr_platform INTERFACE ${SOUI_FR_WARN_FLAGS})
    endif()
    if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
        target_compile_options(soui_fr_platform INTERFACE
            "$<$<COMPILE_LANGUAGE:CXX>:-include>"
            "$<$<COMPILE_LANGUAGE:CXX>:${SOUI_FR_COMPAT_HEADER}>")
    endif()
endfunction()

# -----------------------------------------------------------------------------
# third-party (pixman / zlib / libpng / cairo)
# -----------------------------------------------------------------------------
function(soui_fr_add_thirdparty)
    if(TARGET soui_fr_thirdparty)
        return()
    endif()
    soui_fr_create_platform_target()
    add_library(soui_fr_thirdparty INTERFACE)
    add_library(soui_fr::thirdparty ALIAS soui_fr_thirdparty)

    if(SOUI_FR_USE_SYSTEM_DEPS)
        # Host build: use what the distro already ships.  The vendored tree and
        # MSYS2's cairo are the same release (1.18.4), so pixels do not change;
        # only the ~250-file compile disappears.
        target_link_libraries(soui_fr_thirdparty INTERFACE
            PkgConfig::SOUI_FR_CAIRO PkgConfig::SOUI_FR_PIXMAN
            PkgConfig::SOUI_FR_PNG PkgConfig::SOUI_FR_ZLIB)
        message(STATUS "[soui_fr] third-party: system cairo ${SOUI_FR_CAIRO_VERSION}"
                       " / pixman ${SOUI_FR_PIXMAN_VERSION}")
        return()
    endif()

    set(SWINX_DIR "${SOUI_FR_SWINX_DIR}")
    set(PIXMAN_DIR "${SWINX_DIR}/thirdparty/pixman/pixman")
    set(CAIRO_DIR  "${SWINX_DIR}/thirdparty/cairo/src")
    set(FR_GEN_DIR "${SOUI_FR_CAIRO_GEN_DIR}")

    # pixman-version.h + cairo config.h are build-time generated headers.
    set(PIXMAN_VERSION_MAJOR 0)
    set(PIXMAN_VERSION_MINOR 46)
    set(PIXMAN_VERSION_MICRO 5)
    configure_file("${PIXMAN_DIR}/pixman-version.h.in"
                   "${FR_GEN_DIR}/pixman-version.h" @ONLY)

    if(CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(_size_t 8)
    else()
        set(_size_t 4)
    endif()
    file(WRITE "${FR_GEN_DIR}/config.h" "\
/* config.h -- generated by SouiFreeRTOS.cmake for the vendored cairo build */
#define CAIRO_NO_MUTEX 1
#define HAVE_GCC_LEGACY_ATOMICS 1
#define HAS_PIXMAN_GLYPHS 1
#define HAVE_STDINT_H 1
#define HAVE_INTTYPES_H 1
#define HAVE_STDLIB_H 1
#define HAVE_STRING_H 1
#define HAVE_TIME_H 1
#define HAVE_SETJMP_H 1
#define HAVE_UINT64_T 1
#define SIZEOF_INT 4
#define SIZEOF_LONG 4
#define SIZEOF_LONG_LONG 8
#define SIZEOF_SIZE_T ${_size_t}
#define SIZEOF_VOID_P ${_size_t}
#define PACKAGE_VERSION \"1.18.4\"
")

    # ---- pixman (single-threaded: no TLS) ----------------------------------
    file(GLOB PIXMAN_SRCS "${PIXMAN_DIR}/pixman*.c")
    foreach(_f pixman-mmx.c pixman-sse2.c pixman-ssse3.c pixman-vmx.c
               pixman-rvv.c pixman-mips-dspr2.c
               pixman-region.c)   # template, #included by pixman-region16/32/64f.c
        list(REMOVE_ITEM PIXMAN_SRCS "${PIXMAN_DIR}/${_f}")
    endforeach()
    add_library(pixman_fr STATIC ${PIXMAN_SRCS})
    target_include_directories(pixman_fr PRIVATE "${PIXMAN_DIR}" "${FR_GEN_DIR}")
    target_compile_definitions(pixman_fr PRIVATE PIXMAN_NO_TLS PACKAGE=pixman)
    target_compile_options(pixman_fr PRIVATE ${SOUI_FR_WARN_FLAGS})

    # ---- zlib / libpng ------------------------------------------------------
    file(GLOB ZLIB_SRCS "${SWINX_DIR}/thirdparty/zlib/*.c")
    foreach(_f example.c minigzip.c test/*.c)
        list(REMOVE_ITEM ZLIB_SRCS "${SWINX_DIR}/thirdparty/zlib/${_f}")
    endforeach()
    add_library(zlib_fr STATIC ${ZLIB_SRCS})
    target_include_directories(zlib_fr PRIVATE "${SWINX_DIR}/thirdparty/zlib")
    target_compile_options(zlib_fr PRIVATE ${SOUI_FR_WARN_FLAGS})

    file(GLOB PNG_SRCS "${SWINX_DIR}/thirdparty/libpng/*.c")
    foreach(_f pngtest.c pngexample.c)
        list(REMOVE_ITEM PNG_SRCS "${SWINX_DIR}/thirdparty/libpng/${_f}")
    endforeach()
    add_library(png_fr STATIC ${PNG_SRCS})
    target_include_directories(png_fr PRIVATE
        "${SWINX_DIR}/thirdparty/libpng" "${SWINX_DIR}/thirdparty/zlib")
    target_compile_options(png_fr PRIVATE ${SOUI_FR_WARN_FLAGS})

    # ---- cairo (image surface + png only) ----------------------------------
    file(GLOB CAIRO_SRCS "${CAIRO_DIR}/*.c")
    set(CAIRO_EXCLUDE
        cairo-ft-font.c cairo-quartz-font.c
        cairo-quartz-image-surface.c cairo-quartz-surface.c
        cairo-pdf-interchange.c cairo-pdf-operators.c cairo-pdf-shading.c cairo-pdf-surface.c
        cairo-ps-surface.c cairo-svg-surface.c cairo-script-surface.c
        cairo-xcb-connection-core.c cairo-xcb-connection-render.c cairo-xcb-connection-shm.c
        cairo-xcb-connection.c cairo-xcb-resources.c cairo-xcb-screen.c cairo-xcb-shm.c
        cairo-xcb-surface-core.c cairo-xcb-surface-render.c cairo-xcb-surface.c
        cairo-xlib-core-compositor.c cairo-xlib-display.c cairo-xlib-fallback-compositor.c
        cairo-xlib-render-compositor.c cairo-xlib-screen.c cairo-xlib-source.c
        cairo-xlib-surface-shm.c cairo-xlib-surface.c cairo-xlib-visual.c cairo-xlib-xcb-surface.c
        cairo-image-mask-compositor.c            # template
        cairo-svg-glyph-render.c cairo-colr-glyph-render.c   # freetype-only
        cairo-cff-subset.c cairo-truetype-subset.c cairo-type1-fallback.c cairo-type1-subset.c
        cairo-type1-glyph-names.c cairo-type3-glyph-surface.c cairo-scaled-font-subsets.c
        cairo-paginated-surface.c cairo-deflate-stream.c
        cairo-tee-surface.c
        test-base-compositor-surface.c test-compositor-surface.c
        test-null-compositor-surface.c test-paginated-surface.c)
    foreach(_f ${CAIRO_EXCLUDE})
        list(REMOVE_ITEM CAIRO_SRCS "${CAIRO_DIR}/${_f}")
    endforeach()
    add_library(cairo_fr STATIC ${CAIRO_SRCS})
    target_include_directories(cairo_fr PRIVATE
        "${CAIRO_DIR}"
        "${SWINX_DIR}/src/platform/freertos"   # bare-metal cairo-features.h stub
        "${SWINX_DIR}/thirdparty/libpng"
        "${SWINX_DIR}/thirdparty/zlib"
        "${PIXMAN_DIR}"
        "${FR_GEN_DIR}")
    target_compile_options(cairo_fr PRIVATE ${SOUI_FR_WARN_FLAGS})
    if(WIN32)
        target_compile_definitions(cairo_fr PRIVATE CAIRO_WIN32_STATIC_BUILD)
        # ... and the same for consumers: vendored cairo is a static archive.
        target_compile_definitions(soui_fr_platform INTERFACE CAIRO_WIN32_STATIC_BUILD)
    endif()

    target_link_libraries(soui_fr_thirdparty INTERFACE
        cairo_fr pixman_fr png_fr zlib_fr)
    # Consumers (swinx/src/sdc.h -> <cairo.h>) need the vendored headers too,
    # not only the archives.  In the system-deps branch this comes for free
    # from PkgConfig::SOUI_FR_CAIRO; here it has to be spelled out.  The
    # generated dir carries cairo's config.h / pixman-version.h and must come
    # first so it wins over any in-tree copy.
    target_include_directories(soui_fr_thirdparty INTERFACE
        "${FR_GEN_DIR}"
        "${CAIRO_DIR}"
        "${PIXMAN_DIR}"
        "${SWINX_DIR}/thirdparty/libpng"
        "${SWINX_DIR}/thirdparty/zlib")
    message(STATUS "[soui_fr] third-party: vendored sources (cairo 1.18.4, pixman 0.46.5)")
endfunction()

# -----------------------------------------------------------------------------
# swinx (freertos platform layer + cairo gdi backend)
# -----------------------------------------------------------------------------
function(soui_fr_add_swinx)
    if(TARGET soui_fr_swinx)
        return()
    endif()
    soui_fr_add_thirdparty()

    set(SWINX_DIR "${SOUI_FR_SWINX_DIR}")
    # src/platform/posix/ holds the POSIX system-API implementations; it is
    # deliberately NOT globbed here (same as the ARM target).
    # CONFIGURE_DEPENDS: swinx/SOUI 都是活跃开发的子模块，新增 .cpp 时必须自动
    # 重新 glob。否则已配置过的构建目录会继续用旧的源列表——典型症状是链接期
    # "undefined reference to SwinxXxx"（新文件没进归档），而洁净构建却是好的。
    file(GLOB SWINX_CORE_SRCS CONFIGURE_DEPENDS "${SWINX_DIR}/src/*.cpp")
    list(REMOVE_ITEM SWINX_CORE_SRCS
        "${SWINX_DIR}/src/wgl.cpp")   # GL headers only exist on the host
    file(GLOB SWINX_CMNCTL_SRCS CONFIGURE_DEPENDS
        "${SWINX_DIR}/src/cmnctl32/*.cpp" "${SWINX_DIR}/src/cmnctl32/*.c")

    if(NOT SOUI_FR_SWINX_PLATFORM_SRCS)
        set(SOUI_FR_SWINX_PLATFORM_SRCS
            SConnection.cpp atoms.cpp framebuffer.cpp sysbridge.cpp input.cpp
            dlfreertos.cpp dlghelper.cpp syncapi.cpp winobjs.cpp)
        list(TRANSFORM SOUI_FR_SWINX_PLATFORM_SRCS
             PREPEND "${SWINX_DIR}/src/platform/freertos/")
    endif()

    add_library(swinx_core STATIC
        ${SWINX_CORE_SRCS} ${SWINX_CMNCTL_SRCS} ${SOUI_FR_SWINX_PLATFORM_SRCS}
        # gdi/cairo backend + the FreeRTOS font bridge
        "${SWINX_DIR}/src/gdi/cairo/gdi.cpp"
        "${SWINX_DIR}/src/gdi/cairo/drawtext.cpp"
        "${SWINX_DIR}/src/gdi/cairo/cairo_show_text2.cpp"
        "${SWINX_DIR}/src/gdi/cairo/builtin_image.cpp"
        "${SWINX_DIR}/src/gdi/freertos/textbridge.cpp")
    target_link_libraries(swinx_core PUBLIC soui_fr_platform soui_fr_thirdparty)
    # No extra "-include swinx_stl.h" here: soui_fr_compat.h (force-included by
    # soui_fr_platform) already pulls the STL shims in, and CMake *dedupes*
    # repeated -include options -- a second one would turn its argument into a
    # stray input file ("cannot specify '-o' with multiple files").

    add_library(soui_fr_swinx INTERFACE)
    add_library(soui_fr::swinx ALIAS soui_fr_swinx)
    target_link_libraries(soui_fr_swinx INTERFACE swinx_core)
endfunction()

# -----------------------------------------------------------------------------
# SOUI core stack: utilities + core + render-gdi + imgdecoder-stb
# -----------------------------------------------------------------------------
function(soui_fr_add_soui)
    if(TARGET soui_fr_soui)
        return()
    endif()
    soui_fr_add_swinx()

    set(UTIL_DIR "${SOUI_FR_UTIL_DIR}")
    set(SOUI_DIR "${SOUI_FR_SOUI_DIR}")
    set(ROOT     "${SOUI_FR_ROOT}")

    # ---- utilities ---------------------------------------------------------
    add_library(utilities4_fr STATIC
        "${UTIL_DIR}/src/utilities.cpp"
        "${UTIL_DIR}/src/soui_mem_wrapper.cpp"
        "${UTIL_DIR}/src/gdialpha.cpp"
        "${UTIL_DIR}/src/string/sstringa.cpp"
        "${UTIL_DIR}/src/string/sstringdata.cpp"
        "${UTIL_DIR}/src/string/sstringw.cpp"
        "${UTIL_DIR}/src/string/strcpcvt.cpp"
        "${UTIL_DIR}/src/xml/SXml.cpp"
        "${UTIL_DIR}/src/pugixml/pugixml.cpp"
        "${UTIL_DIR}/src/helper/SAutoBuf.cpp"
        "${UTIL_DIR}/src/helper/SCriticalSection.cpp"
        "${UTIL_DIR}/src/helper/SRwLock.cpp"
        "${UTIL_DIR}/src/helper/SSemaphore.cpp"
        "${UTIL_DIR}/src/helper/STls.cpp"
        "${UTIL_DIR}/src/helper/slog.cpp")
    target_link_libraries(utilities4_fr PUBLIC soui_fr_platform)

    # ---- SOUI core ---------------------------------------------------------
    file(GLOB SOUI_CORE_SRCS   CONFIGURE_DEPENDS "${SOUI_DIR}/src/core/*.cpp")
    file(GLOB SOUI_RESMGR_SRCS CONFIGURE_DEPENDS "${SOUI_DIR}/src/res.mgr/*.cpp")
    file(GLOB SOUI_HELPER_SRCS CONFIGURE_DEPENDS "${SOUI_DIR}/src/helper/*.cpp")
    file(GLOB SOUI_LAYOUT_SRCS CONFIGURE_DEPENDS "${SOUI_DIR}/src/layout/*.cpp")
    file(GLOB SOUI_MATRIX_SRCS CONFIGURE_DEPENDS "${SOUI_DIR}/src/matrix/*.cpp")
    file(GLOB SOUI_EVENT_SRCS  CONFIGURE_DEPENDS "${SOUI_DIR}/src/event/*.cpp")
    file(GLOB SOUI_ANIM_SRCS   CONFIGURE_DEPENDS "${SOUI_DIR}/src/animation/*.cpp")
    file(GLOB SOUI_VANIM_SRCS  CONFIGURE_DEPENDS "${SOUI_DIR}/src/valueAnimator/*.cpp")
    file(GLOB SOUI_CTRL_SRCS   CONFIGURE_DEPENDS "${SOUI_DIR}/src/control/*.cpp")

    # Not portable to this port: accessibility/COM hosting and the
    # Android/OHOS resource providers.
    set(SOUI_EXCLUDES
        "${SOUI_DIR}/src/core/SwndAccessible.cpp"
        "${SOUI_DIR}/src/res.mgr/SResProviderAndroidAsset.cpp"
        "${SOUI_DIR}/src/res.mgr/SResProviderOhosRawFile.cpp"
        "${SOUI_DIR}/src/helper/SOhosApp.cpp")
    foreach(_lst SOUI_CORE_SRCS SOUI_RESMGR_SRCS SOUI_HELPER_SRCS
                 SOUI_LAYOUT_SRCS SOUI_MATRIX_SRCS SOUI_EVENT_SRCS
                 SOUI_ANIM_SRCS SOUI_VANIM_SRCS SOUI_CTRL_SRCS)
        list(REMOVE_ITEM ${_lst} ${SOUI_EXCLUDES})
    endforeach()

    add_library(soui4_fr STATIC
        "${SOUI_DIR}/src/SApp.cpp"
        "${SOUI_DIR}/src/SouiFactory.cpp"
        ${SOUI_CORE_SRCS} ${SOUI_RESMGR_SRCS} ${SOUI_HELPER_SRCS}
        ${SOUI_LAYOUT_SRCS} ${SOUI_MATRIX_SRCS} ${SOUI_EVENT_SRCS}
        ${SOUI_ANIM_SRCS} ${SOUI_VANIM_SRCS} ${SOUI_CTRL_SRCS})
    target_link_libraries(soui4_fr PUBLIC utilities4_fr soui_fr_swinx)
    # SViewBase.cpp needs the SOUI precompiled-header include order.
    set_source_files_properties("${SOUI_DIR}/src/control/SViewBase.cpp" PROPERTIES
        COMPILE_OPTIONS "-include;souistd.h")

    # ---- render-gdi (cairo backend) ---------------------------------------
    add_library(rendergdi_fr STATIC
        "${ROOT}/components/render-gdi/linux/render-gdi.cpp"
        "${ROOT}/components/render-gdi/GradientFillHelper.cpp")
    target_link_libraries(rendergdi_fr PUBLIC soui_fr_platform)
    target_include_directories(rendergdi_fr PUBLIC ${SOUI_FR_INCLUDE_RENDERGDI})

    # ---- imgdecoder-stb (static COM variant) -------------------------------
    add_library(imgdecoder_stb_fr STATIC
        "${ROOT}/components/imgdecoder-stb/imgdecoder-stb.cpp"
        "${ROOT}/third-part/pbl_aupng/src/upng.c"
        "${ROOT}/third-part/pbl_aupng/src/upng_decode.c"
        "${ROOT}/third-part/pbl_aupng/src/upng_inflate.c")
    target_link_libraries(imgdecoder_stb_fr PUBLIC soui_fr_platform)
    target_include_directories(imgdecoder_stb_fr PUBLIC ${SOUI_FR_INCLUDE_IMGSTB})
    target_compile_definitions(imgdecoder_stb_fr PRIVATE
        SOUI_IMAGE_DECODER_USE_STB
        SOUI_IMAGE_DECODER_USE_STB_STATIC)

    add_library(soui_fr_soui INTERFACE)
    add_library(soui_fr::soui ALIAS soui_fr_soui)
    # whole-archive matters: the COM class tables are only reachable through
    # the static registration objects, so the linker must not drop them.
    target_link_libraries(soui_fr_soui INTERFACE
        soui4_fr utilities4_fr rendergdi_fr imgdecoder_stb_fr)
endfunction()

# -----------------------------------------------------------------------------
# FreeRTOS kernel for the host simulation (MSVC_MingW port + heap_3)
# -----------------------------------------------------------------------------
function(soui_fr_add_freertos_host)
    if(TARGET soui_fr_freertos)
        return()
    endif()
    if(SOUI_FR_BARE_METAL)
        message(FATAL_ERROR
            "[soui_fr] soui_fr_add_freertos_host() is for host simulations; "
            "bare-metal projects list the kernel sources themselves.")
    endif()

    add_library(freertos_config INTERFACE)
    target_include_directories(freertos_config SYSTEM INTERFACE ${SOUI_FR_CONFIG_DIR})
    target_compile_definitions(freertos_config INTERFACE projCOVERAGE_TEST=0)

    set(FREERTOS_PORT MSVC_MINGW CACHE STRING "" FORCE)
    set(FREERTOS_HEAP 3 CACHE STRING "" FORCE)
    add_subdirectory("${SOUI_FR_FREERTOS_DIR}"
                     "${CMAKE_BINARY_DIR}/freertos_kernel" EXCLUDE_FROM_ALL)

    add_library(soui_fr_freertos INTERFACE)
    add_library(soui_fr::freertos ALIAS soui_fr_freertos)
    target_link_libraries(soui_fr_freertos INTERFACE freertos_kernel)
endfunction()

# -----------------------------------------------------------------------------
# soui_fr_add_all -- the one-liner for a host simulation / firmware app
# -----------------------------------------------------------------------------
function(soui_fr_add_all)
    soui_fr_create_platform_target()
    soui_fr_add_thirdparty()
    soui_fr_add_swinx()
    soui_fr_add_soui()
    if(NOT SOUI_FR_BARE_METAL)
        soui_fr_add_freertos_host()
    endif()

    if(NOT TARGET soui_fr_app)
        add_library(soui_fr_app INTERFACE)
        add_library(soui_fr::app ALIAS soui_fr_app)
        target_link_libraries(soui_fr_app INTERFACE soui_fr_platform soui_fr_soui)
        if(TARGET soui_fr_freertos)
            target_link_libraries(soui_fr_app INTERFACE soui_fr_freertos)
        endif()
        if(MSVC)
            # nothing extra
        elseif(WIN32)
            target_link_libraries(soui_fr_app INTERFACE winmm)
        else()
            target_link_libraries(soui_fr_app INTERFACE m)
        endif()
    endif()
endfunction()

# -----------------------------------------------------------------------------
# soui_fr_copy_runtime_dlls -- make the executable runnable regardless of PATH
#
# Only meaningful for the system-deps path: there the executable imports
# libcairo-2.dll / libpixman-1-0.dll / ... .  Windows finds those through PATH
# first-come-first-served, and a second MinGW prefix in PATH (PortableGit,
# Android platform-tools, ...) ships an incompatible libwinpthread/zlib/iconv
# that makes the loader abort with 0xc0000139 before main().  Copying the
# right set next to the executable removes the whole class of failure.
# -----------------------------------------------------------------------------
function(soui_fr_copy_runtime_dlls target)
    if(NOT WIN32 OR NOT SOUI_FR_USE_SYSTEM_DEPS)
        return()
    endif()
    if(NOT SOUI_FR_CAIRO_LIBRARY_DIRS)
        return()
    endif()

    set(_hint_bin "")
    foreach(d IN LISTS SOUI_FR_CAIRO_LIBRARY_DIRS)
        get_filename_component(_prefix "${d}" DIRECTORY)
        if(EXISTS "${_prefix}/bin")
            list(APPEND _hint_bin "${_prefix}/bin")
        endif()
    endforeach()
    if(NOT _hint_bin)
        return()
    endif()
    list(REMOVE_DUPLICATES _hint_bin)
    string(REPLACE ";" "\\;" _hint_arg "${_hint_bin}")

    add_custom_command(TARGET ${target} POST_BUILD
        COMMAND "${CMAKE_COMMAND}"
                "-DEXE=$<TARGET_FILE:${target}>"
                "-DOUT_DIR=$<TARGET_FILE_DIR:${target}>"
                "-DHINT_BIN=${_hint_arg}"
                -P "${SOUI_FR_CMAKE_DIR}/CopyRuntimeDlls.cmake"
        COMMENT "[soui_fr] collecting runtime DLLs for ${target}"
        VERBATIM)
endfunction()

# Link an application the way the old per-project CMakeLists did: the SOUI
# libraries must be pulled in whole so the static COM registrations survive.
function(soui_fr_link_app target)
    if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
        target_link_libraries(${target} PRIVATE
            -Wl,--whole-archive soui4_fr utilities4_fr rendergdi_fr imgdecoder_stb_fr
            -Wl,--no-whole-archive)
    else()
        target_link_libraries(${target} PRIVATE
            soui4_fr utilities4_fr rendergdi_fr imgdecoder_stb_fr)
    endif()
    target_link_libraries(${target} PRIVATE soui_fr::app)
    # swinx re-implements Win32 APIs over FreeRTOS primitives; on a host the
    # import libraries also define them, so keep the first (swinx) definition.
    if(WIN32 AND NOT MSVC)
        target_link_options(${target} PRIVATE -Wl,--allow-multiple-definition)
    endif()
    soui_fr_copy_runtime_dlls(${target})
endfunction()
