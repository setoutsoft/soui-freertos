<?xml version="1.0" encoding="utf-8"?>
<skin>
  <!-- Application skin objects.  A skin declared here can be used by name from
       any layout (skin="app_logo") or from code via GETSKIN(L"app_logo", 100). -->
  <imglist name="app_logo" src="PNG:LOGO_PNG"/>
  <!-- 焦点移动动画框(root 节点的 focusAniSkin,配合 animator:duration/interpolator):
       必须关掉 cacheSvg —— 每次焦点变化都按目标窗口的矩形重新矢量绘制,缓存成位图会被拉伸失真 -->
  <imgframe name="skin_focus_ani" src="svg:focus_ani" cacheSvg="0" margin-x="6" margin-y="6"/>
  <!-- 组合框输入区:圆角白底 + 1px 描边。combobox(SComboBase)只画文本和内置下拉按钮
       (SKIN_SYS_DROPBTN),不画自己的 skin,所以白底由外层 window 提供 -->
  <colorrect name="skin_field" normal="@color/thm_color" normalBorder="@color/thm_txt_disabled"
             borderWidth="1" cornerRadius="2"/>
  <!-- 下拉列表背景:SListBox 只画条目、不画背景和边框,所以白底+描边画在弹出窗的
       root 节点皮肤上 -->
  <colorrect name="skin_popup" normal="@color/thm_color" normalBorder="@color/thm_txt_disabled"
             borderWidth="1"/>
</skin>
