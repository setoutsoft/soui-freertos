<?xml version="1.0" encoding="utf-8"?>
<!--
  Main window layout.

  Written the way wizard/CmakeApp writes its layouts:
    * a <caption> with the app icon, the title from @string and the SOUI system
      caption buttons (_skin.sys.btn.minimize / _skin.sys.btn.close),
    * the window background is the system nine-patch _skin.sys.wnd.bkgnd,
    * colours / strings come from uires/values, never from literals,
    * text styles (cls_txt_title / cls_txt_sub) come from uidef/init.xml.
-->
<SOUI name="mainWindow" title="@string/title" wndType="appMain" appWnd="1" margin="0" resizable="0" translucent="0">
  <root skin="_skin.sys.wnd.bkgnd" cache="1" width="320" height="240"
        focusAniSkin="skin_focus_ani" focusAni:duration="200" focusAni:interpolator="Decelerate"
        fade:duration="200" fade:interpolator="Accelerate">
    <!-- simulated title bar -->
    <caption pos="0,0,-0,28" font="adding:2" layout="hbox" gravity="center" padding_left="10">
      <img skin="app_logo" size="16,16"/>
      <text name="txt_title" text="@string/title" extend_left="6" colorText="@color/thm_txt_normal"/>
      <window size="0,0" weight="1" visible="0"/>
      <imgbtn name="btn_min" skin="_skin.sys.btn.minimize" animate="1"/>
      <imgbtn name="btn_close" skin="_skin.sys.btn.close" tip="close" animate="1"/>
    </caption>

    <!-- content: bitmap on the left, description on the right -->
    <img name="img_view" pos="14,32,78,96"/>
    <text class="cls_txt_title" text="@string/hello" pos="88,32,-14,52"/>
    <text class="cls_txt_sub" text="@string/sub" pos="88,54,-14,102"/>

    <!--
      combobox (dropDown=1: the embedded edit is hidden, the control draws the
      selected text itself).  SComboBase paints only the text and the built-in
      drop button (SKIN_SYS_DROPBTN), it never draws its own skin, so the white
      rounded field comes from the wrapper window's skin_field.

      The list itself lives in a *separate* swinx window (SDropDownWnd) that
      blits into the same framebuffer; there is no compositor, so what the main
      window paints while it is open stays painted over it.  Hence:
        * focusable=0 -- taking focus would run the root focus animation
          (focusAniSkin), which repaints a window-sized area and wipes the list;
        * the list must not overlap anim_box / fade_box (they repaint every
          16ms), so it opens downward over the static button row and the
          description text, which is what 24px of free room below the field
          buys us (CalcPopupRect: 130 + 64 <= 240 -> opens downward).
      CMainDlg::OnCbxBeforeCloseUp() repaints the main window once the list is
      dismissed, otherwise its pixels would stay in the framebuffer.
    -->
    <window name="cbx_field" pos="14,106,-14,130" skin="skin_field">
      <combobox name="cbx_speed" pos="0,0,-0,-0" dropDown="1" focusable="1" dropHeight="90" curSel="1"
                animateTime="0" padding="6,0,0,0" drawFocusRect="0" font="adding:-1">
        <dropdownStyle>
          <root skin="skin_popup" colorBkgnd="@color/thm_color"/>
        </dropdownStyle>
        <!-- SListBox 只画条目,背景和 1px 描边由上面的 skin_popup 提供 -->
        <liststyle itemHeight="20" margin="2" colorBkgnd="@color/thm_color"/>
        <items>
          <item text="@string/cbx_slow"/>
          <item text="@string/cbx_normal"/>
          <item text="@string/cbx_fast"/>
        </items>
      </combobox>
    </window>

    <!-- commands handled by CMainDlg via EVENT_ID_COMMAND(R.id.xxx) -->
    <button name="btn_test" class="normalbtn" pos="14,134,110,158" text="@string/btn_switch" animate="1" tip="PNG / SVG"/>
    <button name="btn_anim" class="normalbtn" pos="118,134,214,158" text="@string/btn_anim" animate="1" tip="freeze / resume"/>

    <text class="cls_txt_sub" text="@string/anim_label" pos="14,162,-14,196"/>

    <!-- animation targets, driven by CMainDlg::onAnimationUpdate() -->
    <window name="anim_box" pos="14,202,54,218" colorBkgnd="@color/orange"/>
    <window name="fade_box" pos="14,222,54,238" colorBkgnd="@color/blue"/>
  </root>
</SOUI>
